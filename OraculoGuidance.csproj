<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>OraculoGuidance</AssemblyName>
    <RootNamespace>OraculoGuidance</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>GameData/OraculoGuidance/Plugins/</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Pacote para permitir compilar .NET Framework 4.7.2 no Linux via dotnet CLI -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Caminhos padrão do KSP no Linux e Windows -->
  <PropertyGroup>
    <!-- Pode ser sobrescrito definindo a variável de ambiente KSP_DIR -->
    <KSP_DIR Condition="'$(KSP_DIR)' == '' and Exists('$(HOME)/.steam/steam/steamapps/common/Kerbal Space Program')">$(HOME)/.steam/steam/steamapps/common/Kerbal Space Program</KSP_DIR>
    <KSP_DIR Condition="'$(KSP_DIR)' == '' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Kerbal Space Program')">$(HOME)/.local/share/Steam/steamapps/common/Kerbal Space Program</KSP_DIR>
    <KSP_DIR Condition="'$(KSP_DIR)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/Kerbal Space Program')">C:/Program Files (x86)/Steam/steamapps/common/Kerbal Space Program</KSP_DIR>
    <!-- Fallback caso esteja na mesma pasta -->
    <KSP_DIR Condition="'$(KSP_DIR)' == ''">../../Kerbal Space Program</KSP_DIR>
  </PropertyGroup>

  <!-- Referências do KSP e Unity -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSP_DIR)/KSP_Data/Managed/Assembly-CSharp.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/Assembly-CSharp.dll')">$(KSP_DIR)/KSP_x64_Data/Managed/Assembly-CSharp.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/Assembly-CSharp.dll') and !Exists('$(KSP_DIR)/KSP_x64_Data/Managed/Assembly-CSharp.dll')">Libs/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSP_DIR)/KSP_Data/Managed/UnityEngine.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.dll')">$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.dll') and !Exists('$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.dll')">Libs/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSP_DIR)/KSP_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.CoreModule.dll')">$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.CoreModule.dll') and !Exists('$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.CoreModule.dll')">Libs/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KSP_DIR)/KSP_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.IMGUIModule.dll')">$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.IMGUIModule.dll') and !Exists('$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.IMGUIModule.dll')">Libs/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KSP_DIR)/KSP_Data/Managed/UnityEngine.UI.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.UI.dll')">$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.UI.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/KSP_Data/Managed/UnityEngine.UI.dll') and !Exists('$(KSP_DIR)/KSP_x64_Data/Managed/UnityEngine.UI.dll')">Libs/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Referência ao MechJeb2 (instalado pelo CKAN na pasta GameData) -->
    <Reference Include="MechJeb2">
      <HintPath>$(KSP_DIR)/GameData/MechJeb2/Plugins/MechJeb2.dll</HintPath>
      <HintPath Condition="!Exists('$(KSP_DIR)/GameData/MechJeb2/Plugins/MechJeb2.dll')">Libs/MechJeb2.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
